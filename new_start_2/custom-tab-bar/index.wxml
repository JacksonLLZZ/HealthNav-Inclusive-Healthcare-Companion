<view class="tab-bar">
  <view wx:for="{{list}}" wx:key="index" class="tab-item {{selected === index ? 'tab-item-active' : ''}}" data-index="{{index}}" bindtap="switchTab" hover-class="tab-item-pressed" hover-stay-time="200">
    <view class="tab-icon-wrap">
      <image class="tab-icon" src="{{selected === index ? item.selectedIconPath : item.iconPath}}" mode="aspectFit" />
    </view>
    <text class="tab-text" style="color: {{selected === index ? selectedColor : color}};">{{item.text}}</text>
  </view>
</view>
