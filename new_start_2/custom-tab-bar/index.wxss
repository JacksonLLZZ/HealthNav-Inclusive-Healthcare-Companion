.tab-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 90rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: #FFFFFF;
  border-top: 2rpx solid #E8EDF2;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: 1;
  height: 100%;
  position: relative;
  border-radius: 20rpx;
  margin: 8rpx 6rpx;
  background-color: transparent;
  transition: background-color 0.2s ease, transform 0.15s ease;
  /* Interior safe zone */
  padding: 8rpx 0;
  box-sizing: border-box;
}

/* ===== Active (selected) tab ===== */
.tab-item-active {
  background-color: #E4F3ED;
}

/* ===== Press (finger down) animation ===== */
.tab-item-pressed {
  transform: scale(0.92);
  transition: transform 0.1s ease;
}

/* ===== Icon wrapper — enables smooth image swap ===== */
.tab-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-item-active .tab-icon-wrap {
  transform: scale(1.1);
}

.tab-icon {
  width: 64rpx;
  height: 64rpx;
  display: block;
}

/* ===== Text ===== */
.tab-text {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.1;
  transition: color 0.3s ease;
}
