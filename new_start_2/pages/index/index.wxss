/* Global Container setup */
.container {
    padding: 30rpx;
    background-color: #F0F4F8;
    min-height: 100vh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  
  /* Universal Card Styling for High Contrast */
  .card {
    background-color: #FFFFFF;
    border-radius: 20rpx;
    padding: 40rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.1);
    border: 4rpx solid #E0E0E0; /* High contrast border */
  }
  
  .card-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #555555;
    display: block;
    margin-bottom: 20rpx;
  }
  
  /* Top Section: Step Content */
  .step-content {
    font-size: 44rpx;
    font-weight: bold;
    color: #003366; /* Deep Navy for maximum readability */
    line-height: 1.4;
    display: block;
  }
  
  /* Middle Section: Queue Status */
  .queue-info {
    display: flex;
    justify-content: space-around;
    align-items: center;
    margin-top: 20rpx;
  }
  
  .queue-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .queue-label {
    font-size: 36rpx;
    color: #333333;
    font-weight: 600;
  }
  
  .queue-number {
    font-size: 80rpx;
    font-weight: 900;
    margin-top: 10rpx;
  }
  
  .highlight-orange {
    color: #FF6600; /* Safety Orange */
  }
  
  .highlight-blue {
    color: #003366;
  }
  
  .unit {
    font-size: 40rpx;
    font-weight: bold;
  }
  
  .divider {
    width: 4rpx;
    height: 100rpx;
    background-color: #DCDCDC;
  }
  
  /* Settings Section */
  .settings-card {
    padding: 20rpx 40rpx;
  }
  
  .switch-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx 0;
  }
  
  .border-top {
    border-top: 2rpx solid #EAEAEA;
  }
  
  .switch-label {
    font-size: 40rpx;
    font-weight: bold;
    color: #1A1A1A;
  }
  
  /* Ensure switch controls are scaled up slightly for elderly users */
  switch {
    transform: scale(1.1); 
  }
  
  /* Bottom Actions */
  .bottom-actions {
    margin-top: auto;
    padding-top: 20rpx;
  }
  
  /* Navigation Button */
  .btn-nav {
    background-color: #FF6600;
    color: #FFFFFF;
    font-size: 44rpx;
    font-weight: bold;
    padding: 30rpx 0;
    border-radius: 60rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8rpx 20rpx rgba(255, 102, 0, 0.3);
    margin-bottom: 40rpx;
    line-height: 1.2;
  }
  
  .btn-icon {
    margin-right: 15rpx;
    font-size: 48rpx;
  }
  
  /* AI Voice Bar */
  .ai-bar {
    background-color: #FFFFFF;
    border-radius: 30rpx;
    padding: 25rpx;
    border: 4rpx solid #003366;
    text-align: center;
  }
  
  .ai-hint {
    font-size: 36rpx;
    color: #666666;
    display: block;
    margin-bottom: 20rpx;
    font-weight: bold;
  }
  
  .btn-voice {
    background-color: #003366;
    color: #FFFFFF;
    font-size: 40rpx;
    font-weight: bold;
    border-radius: 50rpx;
    padding: 20rpx 0;
    line-height: 1.3;
  }
  
  /* Button pressed state */
  .btn-voice:active {
    background-color: #002244;
  }

  .hidden-camera {
    position: fixed;
    top: -9999rpx;
    left: -9999rpx;
    width: 2rpx;
    height: 2rpx;
    opacity: 0;
    pointer-events: none;
  }