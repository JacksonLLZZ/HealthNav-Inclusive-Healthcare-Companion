/* ===== Consult 页面 — AI 问诊聊天界面 ===== */

.page {
  height: 100vh;
  background-color: #F5F9FC;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ========== 消息列表 ========== */
.msg-list {
  flex: 1;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.msg-list-inner {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding-bottom: 28rpx;
}

/* 消息行 */
.msg-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  max-width: 85%;
}

.msg-row.user {
  align-self: flex-end;
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 68rpx;
  height: 68rpx;
  background: linear-gradient(135deg, #E3F2FD, #BBDEFB);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.msg-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.msg-bubble {
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  line-height: 1.5;
}

.ai-msg {
  background-color: #FFFFFF;
  border: 1rpx solid #E0E6EC;
  border-bottom-left-radius: 4rpx;
}

.user-msg {
  background: linear-gradient(135deg, #1A7A5C, #26A69A);
  color: #FFFFFF;
  border-bottom-right-radius: 4rpx;
}

.msg-text {
  font-size: 32rpx;
  color: #1A2A3A;
  line-height: 1.7;
}

.user-msg .msg-text {
  color: #FFFFFF;
}

.msg-list-detail {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.msg-detail-item {
  font-size: 30rpx;
  color: #3D4F5E;
  line-height: 1.5;
}

/* 图片消息 */
.msg-image {
  width: 280rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid #E0E6EC;
  background-color: #E8EDF2;
}

.msg-img {
  width: 100%;
  height: 100%;
}

/* ========== 底部输入栏 ========== */
.bottom-bar {
  flex-shrink: 0;
  padding: 18rpx 28rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-top: 1rpx solid #E8EDF2;
}

.bar-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 图片上传按钮 */
.btn-image {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background-color: #F0F4F8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.btn-image:active {
  background-color: #E0E6EC;
}

.btn-image-icon {
  font-size: 36rpx;
}

/* 输入框 */
.input-wrap {
  flex: 1;
  background-color: #F5F9FC;
  border-radius: 60rpx;
  border: 2rpx solid #E0E6EC;
  padding: 0 28rpx;
}

.chat-input {
  height: 80rpx;
  font-size: 30rpx;
  color: #1A2A3A;
  line-height: 80rpx;
}

.input-ph {
  color: #AAB5C0;
  font-size: 30rpx;
}

/* 发送按钮 */
.btn-send {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background-color: #C0CCD8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s;
}

.btn-send.active {
  background: linear-gradient(135deg, #1A7A5C, #2196F3);
}

.btn-send:active {
  opacity: 0.85;
}

.send-icon {
  font-size: 34rpx;
  color: #FFFFFF;
}
