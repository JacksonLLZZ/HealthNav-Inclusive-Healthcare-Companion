/* ===== Clinic Page — Guidance Modules + Compass ===== */

.page {
  padding: 24rpx 28rpx 40rpx;
  background-color: #F5F9FC;
  height: 100vh;
  box-sizing: border-box;
}

/* ===== Module Card (shared) ===== */
.module-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid #E0E6EC;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

.module-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.module-icon {
  font-size: 40rpx;
  line-height: 1;
}

.module-title {
  font-size: calc(36rpx * var(--ts) / 100);
  font-weight: 800;
  color: #1A2A3A;
  line-height: 1.2;
}

/* ===== 1. Current Step ===== */
.step-main {
  font-size: calc(50rpx * var(--ts) / 100);
  font-weight: 900;
  color: #1A7A5C;
  display: block;
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.step-sub {
  font-size: calc(34rpx * var(--bs) / 100);
  color: #1E5A7D;
  display: block;
  line-height: 1.2;
}

/* ===== 2. Queue Status (split) ===== */
.queue-split {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.queue-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.queue-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.queue-divider {
  width: 2rpx;
  height: 80rpx;
  background-color: #E0E6EC;
  flex-shrink: 0;
}

.queue-number {
  font-size: calc(72rpx * var(--ts) / 100);
  font-weight: 900;
  color: #1A2A3A;
  line-height: 1;
}

.queue-time {
  font-size: calc(72rpx * var(--ts) / 100);
  font-weight: 900;
  color: #1A2A3A;
  line-height: 1;
}

.queue-label {
  font-size: calc(30rpx * var(--bs) / 100);
  color: #3D4F5E;
  line-height: 1.2;
}

.queue-bar {
  height: 12rpx;
  background-color: #E8EDF2;
  border-radius: 12rpx;
  overflow: hidden;
}

.queue-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #1A7A5C, #2196F3);
  border-radius: 12rpx;
  transition: width 0.5s ease;
}

/* ===== 3 & 4. Reminder Cards ===== */
.reminder-card {
  padding: 20rpx 28rpx;
}

.reminder-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.reminder-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.reminder-icon {
  font-size: 44rpx;
  flex-shrink: 0;
}

.reminder-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.reminder-title {
  font-size: calc(34rpx * var(--ts) / 100);
  font-weight: 800;
  color: #1A2A3A;
  line-height: 1.2;
}

.reminder-desc {
  font-size: calc(28rpx * var(--bs) / 100);
  color: #3D4F5E;
  line-height: 1.2;
}

.reminder-switch {
  flex-shrink: 0;
  transform: scale(0.9);
}

/* ===== 5. Navigation Trigger ===== */
.nav-trigger {
  padding: 24rpx 28rpx;
}

.nav-trigger-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-trigger-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.nav-trigger-icon {
  font-size: 44rpx;
  flex-shrink: 0;
}

.nav-trigger-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.nav-trigger-title {
  font-size: calc(34rpx * var(--ts) / 100);
  font-weight: 800;
  color: #1A2A3A;
  line-height: 1.2;
}

.nav-trigger-desc {
  font-size: calc(28rpx * var(--bs) / 100);
  color: #3D4F5E;
  line-height: 1.2;
}

.nav-trigger-arrow {
  font-size: calc(48rpx * var(--bs) / 100);
  color: #6A7A88;
  font-weight: 300;
  line-height: 1;
}

.nav-trigger:active {
  background-color: #F5F9FC;
}

/* ===== 6. AI Voice Section ===== */
.ai-section {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 28rpx 28rpx;
  border: 2rpx solid #E0E6EC;
  text-align: center;
  margin-bottom: 24rpx;
}

.ai-hint {
  font-size: calc(34rpx * var(--bs) / 100);
  color: #3D4F5E;
  display: block;
  margin-bottom: 18rpx;
  font-weight: 600;
  line-height: 1.2;
}

.btn-voice {
  background: linear-gradient(135deg, #1A7A5C, #2196F3);
  color: #FFFFFF;
  font-size: calc(40rpx * var(--bs) / 100);
  font-weight: 800;
  border-radius: 60rpx;
  padding: 22rpx 0;
  letter-spacing: 2rpx;
}

.btn-voice::after { border: none; }
.btn-voice:active { opacity: 0.85; }

/* ===== Hidden Camera for Flashlight ===== */
.hidden-camera {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 10rpx;
  height: 10rpx;
  opacity: 0;
  pointer-events: none;
  z-index: -1;
}
