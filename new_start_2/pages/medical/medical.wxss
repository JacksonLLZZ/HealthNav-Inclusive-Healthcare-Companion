/* ===== Medical Card Registration ===== */

.page {
  padding: 28rpx 32rpx 40rpx;
  background-color: #F5F9FC;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ---------- Header ---------- */
.page-header {
  margin-bottom: 28rpx;
}

.page-title {
  font-size: calc(54rpx * var(--ts) / 100);
  font-weight: 900;
  color: #1A2A3A;
  display: block;
  line-height: 1.2;
}

.page-sub {
  font-size: calc(28rpx * var(--bs) / 100);
  color: #3D4F5E;
  margin-top: 8rpx;
  display: block;
  line-height: 1.3;
}

/* ---------- Section ---------- */
.section-block {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid #E0E6EC;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: calc(32rpx * var(--ts) / 100);
  font-weight: 800;
  color: #1A2A3A;
  display: block;
  margin-bottom: 20rpx;
  line-height: 1.2;
}

/* ---------- Upload Boxes ---------- */
.upload-row {
  display: flex;
  gap: 20rpx;
}

.upload-box {
  flex: 1;
  height: 240rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #C0CCD8;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-box:active {
  background-color: #F5F9FC;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.upload-icon {
  font-size: 56rpx;
}

.upload-label {
  font-size: calc(28rpx * var(--bs) / 100);
  color: #3D4F5E;
  font-weight: 500;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

/* ---------- Divider ---------- */
.divider-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background-color: #E0E6EC;
}

.divider-text {
  font-size: calc(28rpx * var(--bs) / 100);
  color: #3D4F5E;
  font-weight: 600;
  flex-shrink: 0;
}

/* ---------- Face Auth Button ---------- */
.face-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background-color: #FFFFFF;
  color: #1A2A3A;
  font-size: calc(34rpx * var(--bs) / 100);
  font-weight: 700;
  border-radius: 24rpx;
  padding: 0;
  margin-bottom: 24rpx;
  border: 2rpx solid #E0E6EC;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.face-btn::after { border: none; }
.face-btn:active { background-color: #F5F9FC; }

/* ---------- Form Inputs ---------- */
.form-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 20rpx;
  background-color: #F5F9FC;
  border-radius: 16rpx;
  font-size: calc(32rpx * var(--bs) / 100);
  color: #1A2A3A;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  border: 2rpx solid #E8EDF2;
}

.form-input:focus {
  border-color: #1A7A5C;
}

.form-input::placeholder {
  color: #5A6A7A;
  font-size: calc(30rpx * var(--bs) / 100);
}

/* ---------- Submit Button ---------- */
.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: linear-gradient(135deg, #1A7A5C, #2196F3);
  color: #FFFFFF;
  font-size: calc(36rpx * var(--bs) / 100);
  font-weight: 800;
  border-radius: 60rpx;
  padding: 0;
  letter-spacing: 2rpx;
  margin-top: 8rpx;
}

.submit-btn::after { border: none; }
.submit-btn:active { opacity: 0.85; }
