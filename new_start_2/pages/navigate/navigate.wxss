/* ===== Navigate Page — Compass Directions ===== */

.page {
  padding: 30rpx 28rpx 40rpx;
  background-color: #F0F4F8;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* Destination Card */
.current-destination {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  border: 4rpx solid #003366;
  margin-bottom: 28rpx;
}

.dest-label {
  font-size: calc(28rpx * var(--bs) / 100);
  color: #2A2A2A;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.dest-text {
  font-size: calc(44rpx * var(--ts) / 100);
  font-weight: 900;
  color: #003366;
  line-height: 1.2;
}

/* Navigation Card */
.nav-card {
  flex: 1;
  border-radius: 40rpx;
  border: 4rpx solid #003366;
  overflow: hidden;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.15);
  background-color: #FFFFFF;
  margin-bottom: 28rpx;
}

.nav-header {
  padding: 50rpx 20rpx 40rpx 20rpx;
  text-align: center;
  border-bottom: 4rpx solid #003366;
  transition: background-color 0.4s ease;
}

.direction-text {
  font-size: calc(72rpx * var(--ts) / 100);
  color: #FFFFFF;
  font-weight: 900;
  display: block;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.arrow-icon {
  font-size: 140rpx;
  margin-top: 15rpx;
  line-height: 1.1;
  display: inline-block;
  transition: transform 0.2s ease-out;
}

.nav-body {
  padding: 36rpx 28rpx;
  text-align: center;
}

.detail-text {
  font-size: calc(44rpx * var(--bs) / 100);
  color: #1A1A1A;
  line-height: 1.4;
  font-weight: bold;
}

.highlight {
  color: #FF6600;
  font-weight: 900;
  text-decoration: underline;
}

/* AI Voice */
.ai-section {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 28rpx 28rpx;
  border: 2rpx solid #E0E6EC;
  text-align: center;
  flex-shrink: 0;
}

.ai-hint {
  font-size: calc(30rpx * var(--bs) / 100);
  color: #3D4F5E;
  display: block;
  margin-bottom: 18rpx;
  font-weight: 600;
  line-height: 1.2;
}

.btn-voice {
  background: linear-gradient(135deg, #1A7A5C, #2196F3);
  color: #FFFFFF;
  font-size: calc(36rpx * var(--bs) / 100);
  font-weight: 800;
  border-radius: 60rpx;
  padding: 22rpx 48rpx;
  letter-spacing: 2rpx;
  width: auto;
  display: inline-block;
}

.btn-voice::after { border: none; }
.btn-voice:active { opacity: 0.85; }
